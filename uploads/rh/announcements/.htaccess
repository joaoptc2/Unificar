# Imagens de capa dos comunicados: leitura liberada, execução nunca.
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
Options -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .phps
AddType text/plain .php .phtml .php3 .php4 .php5 .phps
<FilesMatch "\.(php|phtml|php3|php4|php5|phps)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

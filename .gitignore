# Configuração local (gerada pelo instalador)
/config/config.php

# Dados de runtime
/storage/logs/*
/storage/cache/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
/uploads/*
!/uploads/.htaccess
!/uploads/*/.gitkeep
# As proteções de diretório de upload são versionadas (o servidor precisa delas)
!/uploads/*/.htaccess
!/uploads/*/*/.htaccess

# SO / editores
.DS_Store
Thumbs.db
*.swp

# Cache de runtime dos módulos
modules/*/storage/cache/*
!modules/*/storage/cache/.gitkeep

# Uploads privados (fora do webroot)
/storage/uploads/*
!/storage/uploads/.gitkeep

# Pacotes de backup (banco inteiro + arquivos: nunca vão para o repositório).
# A proteção do diretório e o .gitkeep continuam versionados — o servidor
# precisa do .htaccess já na primeira instalação, antes do primeiro backup.
/storage/backups/*
!/storage/backups/.htaccess
!/storage/backups/.gitkeep
modules/*/logs/*
!modules/*/logs/.gitkeep

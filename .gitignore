# Configuração local (gerada pelo instalador)
/config/config.php

# Dados de runtime
/storage/logs/*
/storage/cache/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
/uploads/*
!/uploads/.htaccess
!/uploads/*/.gitkeep
# As proteções de diretório de upload são versionadas (o servidor precisa delas)
!/uploads/*/.htaccess
!/uploads/*/*/.htaccess

# SO / editores
.DS_Store
Thumbs.db
*.swp

# Cache de runtime dos módulos
modules/*/storage/cache/*
!modules/*/storage/cache/.gitkeep

# Uploads privados (fora do webroot)
/storage/uploads/*
!/storage/uploads/.gitkeep
modules/*/logs/*
!modules/*/logs/.gitkeep

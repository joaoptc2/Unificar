# ═══════════════════════════════════════════════════════════════════════════
#  Variáveis de Ambiente — Sistema de Gestão Documental
#  Copie este arquivo para .env e edite com seus dados.
#  IDEAL: mova o .env para UMA PASTA ACIMA do public_html.
# ═══════════════════════════════════════════════════════════════════════════

# ── Aplicação ──────────────────────────────────────────────────────────────
APP_DEBUG=false
APP_URL=https://documentos.seudominio.com.br
APP_NAME="Sistema de Gestão Documental"

# ── Banco de Dados ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=u000000000_documentos
DB_USER=u000000000_documentos
DB_PASS=TROQUE_ESTA_SENHA
DB_CHARSET=utf8mb4

# ── SMTP (Hostinger) ───────────────────────────────────────────────────────
MAIL_ENABLED=true
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USER=noreply@seudominio.com.br
MAIL_PASS=TROQUE_ESTA_SENHA
MAIL_FROM_NAME="Sistema de Gestão Documental"

# ── Segurança ──────────────────────────────────────────────────────────────
# Tentativas máximas de login antes de bloquear o IP
LOGIN_MAX_ATTEMPTS=5
# Minutos de bloqueio após exceder tentativas
LOGIN_LOCKOUT_MINUTES=15
# Minutos de validade do link "esqueci minha senha"
PASSWORD_RESET_TTL_MINUTES=30

# ── Notificações ───────────────────────────────────────────────────────────
NOTIFY_DAYS_BEFORE=30

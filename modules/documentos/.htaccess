# ═══════════════════════════════════════════════════════════════════════════
#  Módulo DOCUMENTOS — plataforma unificada
#  Este diretório NÃO é mais raiz web. Todo o acesso passa pelo front
#  controller da plataforma (/index.php?m=documentos&url=...).
#  Assets: /assets/documentos · Uploads: /uploads/documentos
# ═══════════════════════════════════════════════════════════════════════════
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>

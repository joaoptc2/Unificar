# Módulo RH da plataforma unificada — executado APENAS via front controller
# raiz (/index.php?m=rh&page=...). Nenhum acesso web direto a este diretório.
# Assets: /assets/rh · Uploads: /uploads/rh
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>
Options -Indexes

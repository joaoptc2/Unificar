# Utilitários de linha de comando. Nada aqui deve ser alcançável por URL.
# A recusa que realmente vale está em scripts/_cli.php, dentro do PHP: este
# arquivo não existe no Nginx e é ignorado no Apache com AllowOverride None.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>
Options -Indexes

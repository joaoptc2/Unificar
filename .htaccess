# ============================================================
# PLATAFORMA UNIFICADA — Apache
# ============================================================

Options -Indexes

# Bloqueia acesso direto a diretórios internos
RewriteEngine On
# `scripts` entrou nesta lista depois de um GET anônimo em
# /scripts/migrate.php aplicar migração de esquema no banco. A recusa que
# vale está dentro do próprio PHP (scripts/_cli.php); esta linha é a
# segunda tranca, para o dia em que alguém puser um .php novo lá sem ela.
RewriteRule ^(core|config|sql|storage|docs|scripts)(/|$) - [F,L]
# Tudo que começa com ponto (.git, .gitignore, .env de quem vier a usar) e
# a documentação da raiz: com o código junto do público, um /.git/config
# servido reconstrói o fonte inteiro. Na arrumação com o código na pasta
# irmã nada disto existe aqui — a regra é para quem ficou na de origem.
# .well-known fica de fora: é por onde o Let's Encrypt prova o domínio, e
# bloqueá-lo faria o certificado parar de renovar em silêncio.
RewriteRule (^|/)\.(?!well-known(/|$))[^/]+ - [F,L]
RewriteRule ^(README|CHANGELOG)[^/]*\.md$ - [F,L]
RewriteRule ^modules/.*\.(php|sql|md)$ - [F,L]

# PHP nunca executa dentro de uploads
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phar|phtml)$ - [F,L]
</IfModule>

# Compressão e cache básico de estáticos
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

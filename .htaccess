# ============================================================
# PLATAFORMA UNIFICADA — Apache
# ============================================================

Options -Indexes

# Bloqueia acesso direto a diretórios internos
RewriteEngine On
RewriteRule ^(core|config|sql|storage|docs)(/|$) - [F,L]
RewriteRule ^modules/.*\.(php|sql|md)$ - [F,L]

# PHP nunca executa dentro de uploads
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phar|phtml)$ - [F,L]
</IfModule>

# Compressão e cache básico de estáticos
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
